{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Firmware: Build (Debug)",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-d",
                "${workspaceFolder}/firmware"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Firmware: Build (Release)",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-d",
                "${workspaceFolder}/firmware",
                "-e",
                "esp32c3"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Firmware: Flash (Upload)",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-d",
                "${workspaceFolder}/firmware",
                "-t",
                "upload"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": ["Firmware: Build (Debug)"]
        },
        {
            "label": "Firmware: Monitor Serial",
            "type": "shell",
            "command": "pio",
            "args": [
                "device",
                "monitor",
                "-d",
                "${workspaceFolder}/firmware"
            ],
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "isBackground": true
        },
        {
            "label": "Firmware: Clean",
            "type": "shell",
            "command": "pio",
            "args": [
                "run",
                "-d",
                "${workspaceFolder}/firmware",
                "-t",
                "clean"
            ],
            "group": "none",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Android: Build Debug APK",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "assembleDebug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/android-app"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Android: Build Release APK",
            "type": "shell",
            "command": "./gradlew",
            "args": [
                "assembleRelease"
            ],
            "options": {
                "cwd": "${workspaceFolder}/android-app"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Android: Install Debug APK",
            "type": "shell",
            "command": "adb",
            "args": [
                "install",
                "-r",
                "${workspaceFolder}/android-app/app/build/outputs/apk/debug/app-debug.apk"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "dependsOn": ["Android: Build Debug APK"]
        }
    ]
}
